[Unit]
Description=RPb5 Proxy Control (pi transition service)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pi
Group=pi
WorkingDirectory=/opt/rpb5-proxy-control
EnvironmentFile=/etc/rpb5-proxy-control/app.env
ExecStart=/opt/rpb5-proxy-control/.venv/bin/gunicorn --workers 2 --bind 127.0.0.1:8080 backend.app:app
Restart=on-failure
RestartSec=2s
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=false
ReadWritePaths=/var/lib/rpb5-proxy-control

[Install]
WantedBy=multi-user.target
